#!/usr/bin/env bash
# Rejects commit messages that reveal the use of an AI tool.
# Activate once per clone: git config core.hooksPath .githooks
# The pattern is shared with pre-push and CI: .githooks/attribution-pattern
msg_file="$1"
hook_dir=$(cd "$(dirname "$0")" && pwd)
pattern=$(cat "$hook_dir/attribution-pattern")
# Only Git's own editor template is skipped; '#' lines typed by the author are scanned.
# Non-ASCII bytes are dropped so look-alike or zero-width characters cannot split a name.
# The repository's own paths ('.claude/' and 'CLAUDE.md') are not attribution.
body=$(sed '/^# Please enter the commit message/,$d' "$msg_file" | LC_ALL=C tr -d '\200-\377' | sed -E 's#\.claude/##g; s#CLAUDE\.md##g')
if printf '%s\n' "$body" | grep -qiE "$pattern"; then
  echo "commit-msg: rejected (AI attribution pattern). See docs/sdd/git-workflow.md section 1." >&2
  exit 1
fi
